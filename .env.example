# Copy to .env and fill in real values. NEVER commit .env
# cp .env.example .env

# --- LLM provider -----------------------------------------------------------
# One of: groq | anthropic | openai | gemini | cerebras | nvidia_nim
# Default is groq — free tier, no credit card, and fast enough for full runs.
LLM_PROVIDER=groq

# Leave MODEL unset to use the provider's default:
#   groq       -> llama-3.3-70b-versatile
#   anthropic  -> claude-sonnet-4-5
#   openai     -> gpt-4.1
#   gemini     -> gemini-2.0-flash
#   cerebras   -> llama-3.3-70b
#   nvidia_nim -> meta/llama-3.1-8b-instruct
MODEL=llama-3.3-70b-versatile

# Low by default: this pipeline wants schema conformance, not creativity.
LLM_TEMPERATURE=0.2

# --- API keys (only the one matching LLM_PROVIDER is required) ---------------
# https://console.groq.com/keys — free tier, no credit card
GROQ_API_KEY=your-groq-key-here

# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# https://aistudio.google.com/apikey
# Note: a key can authenticate yet still have free_tier quota of 0, which
# surfaces as HTTP 429 "limit: 0" on every generateContent call.
# GEMINI_API_KEY=

# https://cloud.cerebras.ai
# CEREBRAS_API_KEY=

# https://build.nvidia.com — free tier, but see the notes in
# src/skill_forge/llm.py: the shared endpoint served small prompts in ~5s and
# never returned at all for the larger tool-using agents.
# NVIDIA_NIM_API_KEY=

# --- Search (required for Agents 2 and 3) -----------------------------------
# https://serper.dev — free tier is ~2,500 queries
SERPER_API_KEY=your-serper-key-here

# --- Optional tuning --------------------------------------------------------
# Max seconds to wait when verifying a URL returns HTTP 200.
LINK_VERIFY_TIMEOUT=6
# Set to 1 to skip live link verification (faster local iteration).
SKIP_LINK_VERIFY=0
